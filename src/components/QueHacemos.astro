---
const servicios = [
  { n: "01", texto: "Streetwear\n& Prendas" },
  { n: "02", texto: "Murales\n& Graffiti" },
  { n: "03", texto: "Serigrafía\n& Estampado" },
  { n: "04", texto: "Identidad &\nArte Urbano" },
  { n: "05", texto: "Música\n& Lanzamientos" },
];
---

<section class="hacemos">
	<div class="hacemos__lista">
		<div class="hacemos__lista__head">
			<h2 class="og-title hacemos__lista__title">Qué Hacemos</h2>
			<span class="og-circle" aria-hidden="true">⟶</span>
		</div>
		{
			servicios.map((servicio) => (
				<div class="hacemos__item">
					<span class="hacemos__item__n">{servicio.n}</span>
					<span class="hacemos__item__texto">{servicio.texto}</span>
				</div>
			))
		}
	</div>

	<div class="hacemos__quote">
		<div class="hacemos__quote__main">
			<span class="hacemos__plus" aria-hidden="true">+</span>
			<p class="hacemos__frase">La ropa y la música<br />cuentan lo mismo.<br />La calle hecha</p>
			<p class="hacemos__acento">MOVIMIENTO.</p>
		</div>
		<div class="hacemos__quote__side">
			<div class="hacemos__globo">
				<svg width="230" height="112" viewBox="0 0 230 112" fill="none" stroke="#4d4d49" stroke-width="1" aria-hidden="true">
					<ellipse cx="115" cy="56" rx="112" ry="52"></ellipse>
					<ellipse cx="115" cy="56" rx="112" ry="26"></ellipse>
					<ellipse cx="115" cy="56" rx="112" ry="8"></ellipse>
					<ellipse cx="115" cy="56" rx="80" ry="52"></ellipse>
					<ellipse cx="115" cy="56" rx="44" ry="52"></ellipse>
					<ellipse cx="115" cy="56" rx="12" ry="52"></ellipse>
				</svg>
			</div>
			<p class="hacemos__nota">
				Cada drop y cada track salen del mismo lugar: la calle, el barrio y la gente.
			</p>
		</div>
	</div>
</section>

<style>
	.hacemos {
		background: var(--color-og-ink);
		display: grid;
		gap: 14px;
		grid-template-columns: 355px minmax(0, 1fr);
		padding: 22px 28px;
	}

	.hacemos__lista,
	.hacemos__quote {
		border: 1px solid var(--color-og-line);
	}

	.hacemos__lista__head {
		align-items: center;
		border-bottom: 1px solid var(--color-og-line);
		display: flex;
		justify-content: space-between;
		padding: 18px 18px 14px;
	}

	.hacemos__lista__title {
		font-size: 22px;
		margin: 0;
	}

	.hacemos__item {
		align-items: center;
		display: grid;
		gap: 8px;
		grid-template-columns: 52px minmax(0, 1fr);
		padding: 14px 18px;
	}

	.hacemos__item:not(:last-child) {
		border-bottom: 1px solid var(--color-og-line-soft);
	}

	.hacemos__item__n {
		color: var(--color-og-lime);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.hacemos__item__texto {
		color: #eaeae6;
		font-size: 11.5px;
		letter-spacing: 0.14em;
		line-height: 1.75;
		text-transform: uppercase;
		white-space: pre-line;
	}

	.hacemos__quote {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
	}

	.hacemos__quote__main {
		padding: 34px 30px 30px;
		position: relative;
	}

	.hacemos__plus {
		color: #6a6a66;
		font-size: 16px;
		position: absolute;
		right: 16px;
		top: 12px;
	}

	.hacemos__frase {
		color: #f3f3ef;
		font-family: var(--font-display);
		font-size: clamp(32px, 3.8vw, 52px);
		letter-spacing: 0.005em;
		line-height: 1.08;
		margin: 0;
		text-transform: uppercase;
	}

	.hacemos__acento {
		color: var(--color-og-lime);
		display: inline-block;
		font-family: var(--font-display);
		font-size: clamp(38px, 4.5vw, 62px);
		letter-spacing: 0.01em;
		line-height: 1;
		margin: 8px 0 0;
		transform: skewX(-11deg);
		transform-origin: left center;
	}

	.hacemos__quote__side {
		border-left: 1px solid var(--color-og-line);
		display: flex;
		flex-direction: column;
	}

	.hacemos__globo {
		align-items: center;
		border-bottom: 1px solid var(--color-og-line);
		display: flex;
		height: 150px;
		justify-content: center;
	}

	.hacemos__globo svg {
		height: auto;
		max-width: 100%;
	}

	.hacemos__nota {
		color: #e2e2de;
		font-size: 12px;
		letter-spacing: 0.14em;
		line-height: 2;
		margin: 0;
		padding: 24px;
		text-transform: uppercase;
	}

	@media (max-width: 1000px) {
		.hacemos {
			grid-template-columns: minmax(0, 1fr);
			padding: 18px;
		}

		.hacemos__quote {
			grid-template-columns: minmax(0, 1fr);
		}

		.hacemos__quote__side {
			border-left: 0;
			border-top: 1px solid var(--color-og-line);
		}
	}
</style>
