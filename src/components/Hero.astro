---
import { Image } from "astro:assets";
import logoPanel from "../assets/logoPanel.jpg";

const transversales = [
  { n: "01", titulo: "Ropa Urbana", texto: "Drops limitados, serigrafía y siluetas oversize." },
  { n: "02", titulo: "Sports", texto: "Uniformes y equipamiento para barrios y ligas." },
  { n: "03", titulo: "Música", texto: "Sencillos, colabs y sonido de sello propio." },
];
---

<header class="hero">
	<div class="hero__grid">
		<div class="hero__left">
			<p class="hero__eyebrow"><span class="hero__dash"></span>La marca</p>

			<h1 class="hero__display">FLOW<br />OG</h1>

			<p class="hero__claims">
				Vestimos la calle.<br />Equipamos el barrio.<br />Sonamos como Quito.
			</p>

			<p class="hero__statement">
				Flow OG nació en Quito como una marca de calle: producción corta, gráfica propia y un
				mismo sello para la ropa, el deporte y la música.
			</p>

			<div class="hero__actions">
				<a class="hero__pill" href="#contacto">Hablemos</a>
				<span class="hero__monogram" aria-hidden="true">OG</span>
			</div>
		</div>

		<div class="hero__right">
			<p class="hero__meta">Ropa urbana<br />Flow OG Sports<br />Música &amp; sello</p>

			<div class="hero__panel">
				<span class="hero__panel__frame" aria-hidden="true"></span>
				<div class="hero__panel__inner">
					<Image src={logoPanel} alt="Logo de Flow OG" widths={[420, 840]} sizes="420px" />
				</div>
				<span class="hero__sticker" aria-hidden="true">Marca<br />Urbana</span>
			</div>
		</div>

		<p class="hero__vertical" aria-hidden="true">Disponible para colabs — Vol. 2 / 2026</p>
	</div>

	<div class="hero__transversales">
		{
			transversales.map((item) => (
				<article class="hero__card">
					<p class="og-eyebrow">{item.n}</p>
					<h2 class="hero__card__title">{item.titulo}</h2>
					<p class="hero__card__text">{item.texto}</p>
				</article>
			))
		}
	</div>
</header>

<style>
	.hero {
		background: var(--color-og-ink);
		border-bottom: 1px solid var(--color-og-line);
		color: var(--color-og-bone);
		position: relative;
	}

	.hero__grid {
		display: grid;
		gap: 40px;
		grid-template-columns: minmax(0, 1fr) minmax(0, 420px) 40px;
		padding: 34px 30px 60px;
		position: relative;
	}

	.hero__eyebrow {
		align-items: center;
		display: flex;
		font-size: 10.5px;
		gap: 12px;
		letter-spacing: 0.3em;
		margin: 0;
		text-transform: uppercase;
	}

	.hero__dash {
		background: var(--color-og-bone);
		display: block;
		height: 2px;
		width: 44px;
	}

	.hero__display {
		font-family: var(--font-display);
		font-size: clamp(88px, 13vw, 186px);
		letter-spacing: -0.035em;
		line-height: 0.84;
		margin: 28px 0 0;
		transform: scaleY(1.16);
		transform-origin: left top;
	}

	.hero__claims {
		font-size: 11.5px;
		letter-spacing: 0.16em;
		line-height: 2.3;
		margin: clamp(48px, 9vw, 120px) 0 0;
		text-transform: uppercase;
	}

	.hero__statement {
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.2;
		margin: 28px 0 0;
		max-width: 520px;
		text-wrap: pretty;
	}

	.hero__actions {
		align-items: center;
		display: flex;
		gap: 24px;
		margin-top: 32px;
	}

	.hero__pill {
		border: 1.4px solid var(--color-og-bone);
		border-radius: 999px;
		color: inherit;
		font-size: 11px;
		letter-spacing: 0.18em;
		padding: 12px 20px;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			background 0.3s ease,
			color 0.3s ease;
	}

	.hero__pill:hover {
		background: var(--color-og-bone);
		color: var(--color-og-ink);
	}

	.hero__monogram {
		align-items: center;
		background: var(--color-og-bone);
		color: var(--color-og-ink);
		display: flex;
		font-family: var(--font-display);
		font-size: 38px;
		height: 96px;
		justify-content: center;
		letter-spacing: -0.02em;
		transform: rotate(4deg);
		width: 96px;
	}

	.hero__meta {
		color: #b8b8b2;
		font-size: 10.5px;
		letter-spacing: 0.16em;
		line-height: 1.9;
		margin: 0 0 26px;
		text-transform: uppercase;
	}

	.hero__panel {
		position: relative;
	}

	.hero__panel__frame {
		border: 1px solid var(--color-og-bone);
		inset: -18px 18px 18px -18px;
		position: absolute;
	}

	.hero__panel__inner {
		aspect-ratio: 404 / 436;
		background: var(--color-og-ink);
		overflow: hidden;
		position: relative;
	}

	.hero__panel__inner :global(img) {
		display: block;
		height: 100%;
		object-fit: contain;
		width: 100%;
	}

	.hero__sticker {
		background: var(--color-og-bone);
		color: var(--color-og-ink);
		font-size: 15px;
		font-weight: 800;
		left: -12%;
		letter-spacing: 0.08em;
		line-height: 1.15;
		padding: 12px 18px;
		position: absolute;
		text-align: center;
		text-transform: uppercase;
		top: 52%;
		transform: rotate(-8deg);
	}

	.hero__vertical {
		border-left: 1px solid var(--color-og-bone);
		color: #b8b8b2;
		font-size: 10px;
		letter-spacing: 0.22em;
		margin: 0;
		padding-left: 12px;
		text-transform: uppercase;
		writing-mode: vertical-rl;
	}

	.hero__transversales {
		border-top: 1px solid var(--color-og-bone);
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.hero__card {
		padding: 22px 28px;
	}

	.hero__card + .hero__card {
		border-left: 1px solid var(--color-og-bone);
	}

	.hero__card__title {
		font-family: var(--font-display);
		font-size: 26px;
		line-height: 1;
		margin: 10px 0 8px;
		text-transform: uppercase;
	}

	.hero__card__text {
		color: var(--color-og-dim);
		font-size: 10.5px;
		letter-spacing: 0.1em;
		line-height: 1.9;
		margin: 0;
		text-transform: uppercase;
	}

	@media (max-width: 1000px) {
		.hero__grid {
			grid-template-columns: minmax(0, 1fr);
			padding: 28px 20px 48px;
		}

		.hero__vertical {
			display: none;
		}

		.hero__sticker {
			left: auto;
			right: 8%;
			top: -22px;
		}
	}

	@media (max-width: 720px) {
		.hero__transversales {
			grid-template-columns: minmax(0, 1fr);
		}

		.hero__card + .hero__card {
			border-left: 0;
			border-top: 1px solid var(--color-og-bone);
		}

		.hero__actions {
			flex-wrap: wrap;
		}
	}
</style>
