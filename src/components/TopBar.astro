---
const items = [
  { texto: "Trabajos selectos", tono: "claro" },
  { texto: "2026", tono: "tenue" },
  { texto: "Arte.Calle.Cultura.", tono: "claro" },
];
---

<div class="topbar">
	<div class="topbar__row">
		{
			items.map((item) => (
				<span class:list={["topbar__cell", item.tono === "tenue" && "topbar__cell--dim"]}>
					{item.texto}
				</span>
			))
		}
		<span class="topbar__cell topbar__cell--dim topbar__cell--push">Hecho en</span>
		<span class="topbar__cell">Quito, EC</span>
		<span class="topbar__cell topbar__cell--icon" aria-hidden="true">
			<span class="topbar__cross"></span>
		</span>
	</div>
	<div class="topbar__code" aria-hidden="true">
		{
			[2, 4, 1, 3, 1, 5, 2, 2, 4, 1, 3, 2, 1, 4, 2, 1, 3, 5, 1, 2].map((ancho) => (
				<span style={`width:${ancho}px`} />
			))
		}
	</div>
</div>

<style>
	.topbar {
		border-bottom: 1px solid var(--color-og-line);
		display: grid;
		grid-template-columns: minmax(0, 1fr) 250px;
	}

	.topbar__row {
		align-items: center;
		color: var(--color-og-text);
		display: flex;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.14em;
		min-height: 44px;
		overflow: hidden;
		text-transform: uppercase;
	}

	.topbar__cell {
		padding: 0 22px;
		white-space: nowrap;
	}

	.topbar__cell + .topbar__cell {
		border-left: 1px solid var(--color-og-line);
	}

	.topbar__cell--dim {
		color: var(--color-og-muted);
	}

	.topbar__cell--push {
		margin-left: auto;
	}

	.topbar__cell--icon {
		align-items: center;
		align-self: stretch;
		display: flex;
		justify-content: center;
		padding: 0;
		width: 44px;
	}

	.topbar__cross {
		border: 1.4px solid var(--color-og-lime);
		border-radius: 50%;
		display: block;
		height: 15px;
		position: relative;
		width: 15px;
	}

	.topbar__cross::before,
	.topbar__cross::after {
		background: var(--color-og-lime);
		content: "";
		position: absolute;
	}

	.topbar__cross::before {
		height: 1.4px;
		left: -1.4px;
		top: 6px;
		width: 15px;
	}

	.topbar__cross::after {
		height: 15px;
		left: 6px;
		top: -1.4px;
		width: 1.4px;
	}

	.topbar__code {
		align-items: flex-end;
		border-left: 1px solid var(--color-og-line);
		display: flex;
		gap: 2px;
		justify-content: center;
		padding: 0 14px;
	}

	.topbar__code span {
		background: #e9e9e5;
		height: 22px;
	}

	@media (max-width: 900px) {
		.topbar {
			grid-template-columns: minmax(0, 1fr);
		}

		.topbar__code {
			display: none;
		}

		.topbar__cell {
			padding: 0 14px;
		}
	}
</style>
